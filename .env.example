# ===== Server =====
PORT=3069
NODE_ENV=development

# ===== Database =====
# Khi chạy bằng docker compose, DATABASE_URL được compose ghi đè (app gọi DB qua tên service "db").
# Giá trị dưới đây chỉ dùng khi chạy app trực tiếp bằng npm với MySQL cài sẵn trên máy.
DATABASE_URL=mysql://root:root123@localhost:3306/capstone_nodejs
# Mật khẩu root của MySQL trong docker compose
DB_ROOT_PASSWORD=root123

# ===== JWT =====
ACCESS_TOKEN_SECRET_KEY=change-me-access-secret
REFRESH_TOKEN_SECRET_KEY=change-me-refresh-secret

# ===== Google OAuth (cần khóa thật nếu muốn thử đăng nhập Google) =====
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3069/api/auth/google/callback
FRONTEND_URL=http://localhost:5173

# ===== Cloudinary (cần khóa thật nếu muốn thử upload ảnh) =====
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
